POSTGRES_PASSWORD=replace_with_a_long_random_password

# Coinbase BTC-USD public market data requires no API key.
# XAUUSD uses Twelve Data. Confirm your plan supports XAU/USD and real-time WebSocket access.
TWELVEDATA_API_KEY=replace_with_your_twelvedata_api_key

# Use PostgreSQL for persistent deployments; SQLite is for local development.
DATABASE_URL=postgresql+psycopg://tradex:change_this_password@db:5432/tradex

# Exact public app origin(s), comma-separated. Never use * in production.
CORS_ORIGINS=http://localhost:8000

# Keep false until restart/recovery behavior and operational alerts are reviewed.
AUTO_RESUME_ON_RESTART=false

# Supabase project settings. The anon/publishable key is public; NEVER put service_role here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Customer support email delivery via Resend (use a verified sender domain/address).
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_EMAIL=TradeX AI Support <support@your-verified-domain.com>
SUPPORT_TO_EMAIL=your-support-inbox@example.com

# Comma-separated Supabase-authenticated email addresses allowed into /admin/support.
ADMIN_EMAILS=your-admin-login@example.com
